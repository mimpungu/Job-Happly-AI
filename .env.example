# Copier vers .env (jamais versionné). Ne mettre aucune vraie valeur ici.
# Environnements : development | test | production (HAPPLY_ENVIRONMENT).
# En production, utiliser un gestionnaire de secrets ou des variables injectées, pas ce fichier.

HAPPLY_ENVIRONMENT=development
HAPPLY_HOST=127.0.0.1
HAPPLY_PORT=8000
HAPPLY_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
HAPPLY_LOG_LEVEL=INFO

# PostgreSQL (Docker Compose). Remplacer le mot de passe d'exemple, il est refusé en production.
POSTGRES_USER=happly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=happly
HAPPLY_DATABASE_URL=postgresql://happly:change-me@127.0.0.1:5432/happly

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# IA — Gemini (Google AI Studio). Clé à coller UNIQUEMENT ici (jamais dans le code, un chat ou Git).
# Palier « free » : Google peut réutiliser et faire relire les contenus -> offres publiques seulement.
# Passer à « paid » uniquement si un compte de facturation Google est lié à la clé.
HAPPLY_GEMINI_API_KEY=
HAPPLY_GEMINI_TIER=free

# IA — modèle local Ollama (gratuit, rien ne quitte la machine). Installer : brew install ollama.
HAPPLY_OLLAMA_ENABLED=false
HAPPLY_OLLAMA_MODEL_LEVEL1=gemma4:e4b
HAPPLY_OLLAMA_MODEL_LEVEL2=gemma4:12b

# Compilation LaTeX (CV, lettres). Vide = recherche automatique de pdflatex (PATH, MacTeX, TeX Live).
# macOS : brew install --cask mactex-no-gui. Linux : apt install texlive-latex-extra lmodern.
HAPPLY_PDFLATEX_PATH=
HAPPLY_LATEX_TIMEOUT_SECONDS=15
HAPPLY_LATEX_MEMORY_LIMIT_MB=1024

# API France Travail (Offres d'emploi v2) : actuellement retirée du portail par France Travail.
# À renseigner uniquement si un accès est accordé sur demande (jamais versionné, jamais dans le code).
HAPPLY_FRANCE_TRAVAIL_CLIENT_ID=
HAPPLY_FRANCE_TRAVAIL_CLIENT_SECRET=
